{
  // Project settings and recommended extensions live in .vscode/, so they also apply when opening the folder directly.
  "folders": [
    {
      "name": "Echora Web",
      "path": "."
    }
  ],
  "settings": {
    // Window-wide settings in .vscode/settings.json don't apply when the project is opened through this file, so this
    // one is repeated here: the Tailwind language mode, where @apply, @theme... aren't unknown at-rules for the CSS linter.
    "files.associations": {
      "*.css": "tailwindcss"
    }
  }
}
