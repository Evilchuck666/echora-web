{
  // Folder-scoped settings only (resource and language scopes). The project is opened through echora-web.code-workspace,
  // and VS Code ignores window-scoped settings in this file when it is: those live in the workspace file. Never repeat
  // a setting in both places.

  // Moving or renaming a file updates the imports that point to it, without asking.
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // oxlint (.oxlintrc.json, the rules of `bun run lint`) applies its fixes when a file is saved by hand. No formatter has
  // been chosen yet (see CLAUDE.md), so nothing formats on save.
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },

  // Tailwind class suggestions as you type inside className="..." strings (the components are .tsx files).
  "[typescriptreact]": {
    "editor.quickSuggestions": {
      "strings": "on"
    }
  },
  // Class lists kept in constants, outside className (PRIMARY_BUTTON in src/components/forms.tsx, ON_HOVER in
  // src/components/TrackItem.tsx...): Tailwind completions, hovers and linting in them too.
  "tailwindCSS.experimental.classRegex": ["const [A-Z][A-Z0-9_]* = '([^']*)'"],

  // The NPM Scripts view runs the scripts of package.json through Bun.
  "npm.packageManager": "bun",

  // The web app manifest (.json rather than .webmanifest, see CLAUDE.md), checked against its schema.
  "json.schemas": [
    {
      "fileMatch": ["/public/manifest.json"],
      "url": "https://www.schemastore.org/web-manifest-combined.json"
    }
  ],

  // Playwright's reports and results (bun run test:e2e, git-ignored).
  "files.exclude": {
    "playwright-report": true,
    "test-results": true
  },
  // The production build (bun run build) rewrites dist/ at once: don't watch it.
  "files.watcherExclude": {
    "**/dist/**": true
  },
  // Search already leaves out what .gitignore ignores (node_modules/, dist/...). bun.lock is tracked, but only noise in
  // results.
  "search.exclude": {
    "bun.lock": true
  }
}
