{
  // The editor's built-in JavaScript debugger with Google Chrome, on the Vite dev server (the "Dev server" task, started
  // first). The debug browser runs with a profile of its own: if API calls fail, accept the https://localhost certificate
  // there once too (see CLAUDE.md, "Local development").
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Dev server"
    }
  ]
}
