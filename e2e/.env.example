# Account the live end-to-end tests sign in with (bun run test:e2e:live): its username or its email. Copy to e2e/.env
# (git-ignored). Create a dedicated one from Users in the web client, or in ../Echora:
# docker compose exec php bin/console app:user:create e2e@example.com
ECHORA_E2E_USERNAME=e2e
ECHORA_E2E_PASSWORD=

# Optional: run the live tests against a deployed Echora (web client and API on one origin) instead of Vite and
# the local API, e.g. right after deploying.
#ECHORA_E2E_BASE_URL=https://music.example.com
